{
  "name": "purchase-planner",
  "productName": "PurchasePlanner",
  "version": "1.0.0",
  "description": "Demand forecasting and purchase ordering (Fixed Order Period)",
  "main": "src/main.bundle.js",
  "author": "Purchasing",
  "license": "UNLICENSED",
  "scripts": {
    "start": "npm run bundle && electron .",
    "test": "node test/engine.unit.test.js",
    "dist": "npm run bundle && electron-builder --win --x64",
    "test:unit": "node test/engine.unit.test.js",
    "test:excel": "node test/engine.test.js",
    "bundle": "esbuild src/main.js --bundle --platform=node --target=node20 --external:electron --external:canvas --outfile=src/main.bundle.js --log-level=warning"
  },
  "build": {
    "appId": "local.purchase.planner",
    "productName": "PurchasePlanner",
    "files": [
      "src/main.bundle.js",
      "src/preload.js",
      "src/renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "PurchasePlanner-Setup.exe",
      "createDesktopShortcut": true,
      "shortcutName": "تخطيط المشتريات"
    },
    "publish": null
  },
  "devDependencies": {
    "@e965/xlsx": "^0.20.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "exceljs": "^4.4.0",
    "pdfjs-dist": "^3.11.174"
  }
}
